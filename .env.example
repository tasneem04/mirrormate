# Copy this file to .env and fill in your values. Never commit .env.

# YouCam API key from https://yce.perfectcorp.com/ai-api (API Keys tab)
YOUCAM_API_KEY=

# Optional. When set, the live (unit-spending) YouCam calls need this passcode.
# Everyone else gets demo mode. Set it on the public deploy to protect your units.
LIVE_PASSCODE=

# Optional. Google Gemini key (free tier: https://aistudio.google.com/apikey) for "Smart identify"
# on product photos. Without it the button is hidden and the on-device model is used.
GEMINI_API_KEY=
# Optional model override. Default: gemini-3.8-flash
GEMINI_MODEL=
